# Local environment variables for backend
PORT=5000
MONGO_URI=mongodb://localhost:27017/drivewise
JWT_SECRET=your_jwt_secret_here
# OTP emails use Brevo transactional API.
# Configure these in local/deployment environments:
# BREVO_API_KEY=your_brevo_api_key
# BREVO_SENDER_EMAIL=your_verified_sender@gmail.com
# BREVO_SENDER_NAME=DriveWise
# Local socket URL for development (active)
SOCKET_URL=http://localhost:8900

# Deployment socket URL (uncomment and use this when deploying)
# SOCKET_URL=https://drivewisesocket.onrender.com
